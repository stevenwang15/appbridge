{
  "name": "ask-local",
  "when": "问本机模型一个问题，答案存成文件并弹通知",
  "args": {
    "prompt": {
      "type": "string",
      "required": true
    },
    "model": {
      "type": "string",
      "default": "qwen3.6:27b"
    },
    "out": {
      "type": "string",
      "default": "out/ask-{{stamp}}.md"
    }
  },
  "steps": [
    {
      "id": "resp",
      "tool": "ollama.chat",
      "args": {
        "model": "{{model}}",
        "prompt": "{{prompt}}"
      }
    },
    {
      "id": "answer",
      "tool": "json.get",
      "args": {
        "data": "{{$1}}",
        "path": "message.content"
      }
    },
    {
      "id": "doc",
      "tool": "text.join",
      "args": {
        "items": [
          "# {{prompt}}",
          "",
          "模型: {{model}}",
          "时间: {{date}} {{time}}",
          "",
          "{{$2}}"
        ],
        "sep": "\n"
      }
    },
    {
      "id": "save",
      "tool": "fs.write",
      "args": {
        "path": "{{out}}",
        "content": "{{$3}}"
      }
    },
    {
      "id": "notify",
      "tool": "sys.notify",
      "args": {
        "text": "答完了，结果在 {{out}}",
        "title": "appbridge"
      }
    }
  ]
}
